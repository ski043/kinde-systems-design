// use prisma-8

// A display copy of the member's Kinde role. Permission checks never read it.
enum MemberRole {
  @@type("pg/text@1")
  Owner   = "owner"
  Support = "support"
}

enum WidgetColor {
  @@type("pg/text@1")
  Blue   = "blue"
  Indigo = "indigo"
  Violet = "violet"
  Pink   = "pink"
  Red    = "red"
  Orange = "orange"
  Green  = "green"
}

enum WidgetPosition {
  @@type("pg/text@1")
  BottomLeft  = "bottom-left"
  BottomRight = "bottom-right"
}

model Workspace {
  id             Uuid                  @id @default(uuid(7))
  name           String
  kindeOrgCode   String                @unique @map("kinde_org_code")
  // Null for a workspace created before billing; it has no plan.
  kindeBillingCustomerId String?       @unique @map("kinde_billing_customer_id")
  // Bumped by Kinde billing webhooks. Billing state cached before it is stale.
  billingChangedAt DateTime            @default(now()) @map("billing_changed_at")
  agentEnabled   Boolean               @default(true) @map("agent_enabled")
  // Null means "{workspace name} Agent", so renaming the workspace carries over.
  agentName      String?               @map("agent_name")
  agentAvatarKey String?               @map("agent_avatar_key")
  color          WidgetColor           @default(Blue)
  position       WidgetPosition        @default(BottomRight)
  greeting       String?
  allowedDomains String[]              @default([]) @map("allowed_domains")
  snippetInstalledAt DateTime?         @map("snippet_installed_at")
  // Generated from the knowledge base; empty while it has no ready sources.
  suggestedQuestions String[]          @default([]) @map("suggested_questions")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      temporal.updatedAt() @map("updated_at")

  members       Member[]
  visitors      Visitor[]
  conversations Conversation[]
  messages      Message[]
  sources       Source[]
  chunks        Chunk[]
  agentTurns    AgentTurn[]
  invitations   Invitation[]
  aiReplies     AiReply[]
  usageReports  UsageReport[]

  @@map("workspaces")
}

model Member {
  id          Uuid                  @id @default(uuid(7))
  workspaceId Uuid                  @map("workspace_id")
  // Unique: a person belongs to at most one workspace.
  kindeUserId String                @unique @map("kinde_user_id")
  email       String
  role        MemberRole
  name        String
  avatarUrl   String?               @map("avatar_url")
  avatarKey   String?               @map("avatar_key")
  // Bumped on every role change. Tokens issued before it carry stale permissions.
  accessChangedAt DateTime          @default(now()) @map("access_changed_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   temporal.updatedAt() @map("updated_at")

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages         Message[]
  invitationsSent  Invitation[]

  @@index([workspaceId])
  @@map("members")
}

enum ConversationState {
  @@type("pg/text@1")
  Ai      = "ai"
  Waiting = "waiting"
  Human   = "human"
  Closed  = "closed"
}

enum HandoffReason {
  @@type("pg/text@1")
  LowConfidence       = "low_confidence"
  NoRelevantKnowledge = "no_relevant_knowledge"
  VisitorRequested    = "visitor_requested"
  AgentOff            = "agent_off"
  AiReplyLimit        = "ai_reply_limit"
}

enum MessageAuthor {
  @@type("pg/text@1")
  Visitor = "visitor"
  Agent   = "agent"
  Member  = "member"
  System  = "system"
}

enum MessageClassification {
  @@type("pg/text@1")
  SupportQuestion = "support_question"
  SmallTalk       = "small_talk"
  OffTopic        = "off_topic"
  HumanRequest    = "human_request"
}

model Visitor {
  id          Uuid     @id @default(uuid(7))
  workspaceId Uuid     @map("workspace_id")
  // SHA-256 of the secret carried in the visitor token; the token itself is never stored.
  tokenHash   String   @unique @map("token_hash")
  details     Jsonb
  visitCount  Int      @default(1) @map("visit_count")
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([workspaceId])
  @@map("visitors")
}

model Conversation {
  id                   Uuid              @id @default(uuid(7))
  workspaceId          Uuid              @map("workspace_id")
  visitorId            Uuid              @map("visitor_id")
  state                ConversationState
  handoffReason        HandoffReason?    @map("handoff_reason")
  lastMessageAt        DateTime          @default(now()) @map("last_message_at")
  lastVisitorMessageAt DateTime?         @map("last_visitor_message_at")
  ownerReadAt          DateTime?         @map("owner_read_at")
  // Bumped with clock_timestamp() on every state change and message, so clients can drop stale copies.
  updatedAt            DateTime          @default(now()) @map("updated_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  closedAt             DateTime?         @map("closed_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  visitor   Visitor   @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  messages  Message[]
  aiReplies AiReply[]

  @@index([workspaceId, lastMessageAt])
  @@index([visitorId], where: "(state <> 'closed')", unique: true, name: "conversations_one_open_per_visitor")
  @@map("conversations")
}

model Message {
  id             Uuid                   @id @default(uuid(7))
  conversationId Uuid                   @map("conversation_id")
  workspaceId    Uuid                   @map("workspace_id")
  author         MessageAuthor
  memberId       Uuid?                  @map("member_id")
  body           String                 @default("")
  // System messages only: the greeting, handoff and state-change events.
  event          Jsonb?
  classification MessageClassification?
  declined       Boolean                @default(false)
  createdAt      DateTime               @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member       Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  agentTurns   AgentTurn[]
  aiReplies    AiReply[]

  @@index([conversationId, createdAt])
  @@index([workspaceId])
  @@map("messages")
}

enum SourceKind {
  @@type("pg/text@1")
  File = "file"
  Text = "text"
}

enum SourceStatus {
  @@type("pg/text@1")
  Uploaded   = "uploaded"
  Processing = "processing"
  Ready      = "ready"
  Failed     = "failed"
}

model Source {
  id          Uuid         @id @default(uuid(7))
  workspaceId Uuid         @map("workspace_id")
  kind        SourceKind
  // The file name for files, the title for text sources.
  name        String
  storageKey  String?      @map("storage_key")
  text        String?
  mimeType    String?      @map("mime_type")
  // Bytes for files, characters for text sources.
  size        Int
  status      SourceStatus
  error       String?
  // Every ingest run claims the next revision; only the latest claim may write its result.
  revision    Int          @default(0)
  // ETag of the stored file the current chunks were built from.
  ingestedEtag String?     @map("ingested_etag")
  chunkCount  Int          @default(0) @map("chunk_count")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @default(now()) @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks    Chunk[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, name], where: "(kind = 'file')", unique: true, name: "sources_one_file_per_name")
  @@map("sources")
}

model Chunk {
  id          Uuid                          @id @default(uuid(7))
  workspaceId Uuid                          @map("workspace_id")
  sourceId    Uuid                          @map("source_id")
  position    Int
  content     String
  tokenCount  Int                           @map("token_count")
  embedding   pgvector.Vector(length: 1024)
  createdAt   DateTime                      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source    Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([sourceId, position])
  @@map("chunks")
}

enum AgentTurnOutcome {
  @@type("pg/text@1")
  Answered  = "answered"
  SmallTalk = "small_talk"
  Declined  = "declined"
  Handoff   = "handoff"
  // A newer visitor message or a take-over made the result obsolete; nothing was saved.
  Discarded = "discarded"
  Failed    = "failed"
}

model AgentTurn {
  id               Uuid                   @id @default(uuid(7))
  workspaceId      Uuid                   @map("workspace_id")
  conversationId   Uuid                   @map("conversation_id")
  // The visitor message this turn responded to.
  messageId        Uuid                   @map("message_id")
  replyMessageId   Uuid?                  @map("reply_message_id")
  classification   MessageClassification
  outcome          AgentTurnOutcome
  handoffReason    HandoffReason?         @map("handoff_reason")
  chunkIds         Uuid[]                 @default([]) @map("chunk_ids")
  // The sources the reply was answered from, so the inbox can show them after re-ingests.
  sourceIds        Uuid[]                 @default([]) @map("source_ids")
  scores           Float[]                @default([])
  classifierModel  String                 @map("classifier_model")
  model            String?
  tokensIn         Int                    @default(0) @map("tokens_in")
  tokensOut        Int                    @default(0) @map("tokens_out")
  latencyMs        Int                    @map("latency_ms")
  firstTokenMs     Int?                   @map("first_token_ms")
  error            String?
  createdAt        DateTime               @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([messageId])
  @@map("agent_turns")
}

enum InvitationRole {
  @@type("pg/text@1")
  Support = "support"
}

enum InvitationStatus {
  @@type("pg/text@1")
  Pending  = "pending"
  Accepted = "accepted"
  Revoked  = "revoked"
}

model Invitation {
  id                Uuid             @id @default(uuid(7))
  workspaceId       Uuid             @map("workspace_id")
  // Stored lowercased; matched against the invitee's verified Kinde email.
  email             String
  role              InvitationRole
  invitedByMemberId Uuid             @map("invited_by_member_id")
  status            InvitationStatus @default(Pending)
  createdAt         DateTime         @default(now()) @map("created_at")
  acceptedAt        DateTime?        @map("accepted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy Member    @relation(fields: [invitedByMemberId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, email], where: "(status = 'pending')", unique: true, name: "invitations_one_pending_per_email")
  @@map("invitations")
}

enum AiReplyStatus {
  @@type("pg/text@1")
  Pending   = "pending"
  Succeeded = "succeeded"
  Failed    = "failed"
}

// Succeeded rows are the usage ledger for AI replies: the agent's answers to support questions.
model AiReply {
  id             Uuid          @id @default(uuid(7))
  workspaceId    Uuid          @map("workspace_id")
  conversationId Uuid          @map("conversation_id")
  // The visitor message answered. The idempotency key: a message counts at most once.
  messageId      Uuid          @map("message_id")
  status         AiReplyStatus @default(Pending)
  model          String
  tokensIn       Int           @default(0) @map("tokens_in")
  tokensOut      Int           @default(0) @map("tokens_out")
  latencyMs      Int?          @map("latency_ms")
  error          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  finishedAt     DateTime?     @map("finished_at")

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, messageId])
  @@index([workspaceId, status, finishedAt])
  @@index([conversationId])
  @@index([messageId])
  @@map("ai_replies")
}

// One accepted absolute total sent to Kinde Billing for a billing cycle.
model UsageReport {
  id               Uuid      @id @default(uuid(7))
  workspaceId      Uuid      @map("workspace_id")
  feature          String
  kindeAgreementId String    @map("kinde_agreement_id")
  cycleStart       DateTime  @map("cycle_start")
  cycleEnd         DateTime  @map("cycle_end")
  reportedTotal    Int       @map("reported_total")
  kindeRecordId    String    @map("kinde_record_id")
  reportedAt       DateTime  @default(now()) @map("reported_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, kindeAgreementId, cycleStart, reportedAt], name: "usage_reports_latest")
  @@map("usage_reports")
}

// Kinde webhook deliveries already handled, by their `webhook-id` header.
model KindeWebhookDelivery {
  webhookId  String   @id @map("webhook_id")
  type       String
  receivedAt DateTime @default(now()) @map("received_at")

  @@map("kinde_webhook_deliveries")
}
